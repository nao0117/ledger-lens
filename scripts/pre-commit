#!/bin/sh
# 実データの混入を防ぐコミット前チェック（docs/requirements.md 7.4）
# 有効化: sh scripts/install-hooks.sh

status=0

# 1. データファイルの拡張子をブロックする（fixtures の JSON と設定用の JSON は許可）
blocked=$(git diff --cached --name-only --diff-filter=ACMR | grep -Ei '\.(xlsx|xls|xlsm|csv|tsv|ods|json)$' \
  | grep -Ev '^(package(-lock)?\.json|tsconfig[^/]*\.json)$' \
  | grep -Ev '^src/(.+/)?fixtures/[^/]+\.json$')
if [ -n "$blocked" ]; then
  echo "pre-commit: データファイルはコミットできません:" >&2
  echo "$blocked" | sed 's/^/  /' >&2
  status=1
fi

# 2. 環境変数ファイルとデータ用ディレクトリをブロックする
envs=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env' | grep -v '\.env\.example$')
dirs=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^(data|private)/')
if [ -n "$envs$dirs" ]; then
  echo "pre-commit: .env やデータ用ディレクトリはコミットできません:" >&2
  printf '%s\n%s\n' "$envs" "$dirs" | sed '/^$/d; s/^/  /' >&2
  status=1
fi

# 3. 任意: .git/info/sensitive-patterns に自分の金額の一部などを1行ずつ書くと、差分を検索する
#    （このファイルは .git 内にあるのでコミットされない）
patterns=.git/info/sensitive-patterns
if [ -s "$patterns" ]; then
  if git diff --cached -U0 | grep '^+' | grep -qFf "$patterns"; then
    echo "pre-commit: $patterns に一致する文字列が差分に含まれています。" >&2
    status=1
  fi
fi

if [ $status -ne 0 ]; then
  echo "意図した変更であることを確認できた場合だけ --no-verify を使ってください。" >&2
fi
exit $status
